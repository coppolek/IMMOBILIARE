# ==============================================================================
# Affitti Milano - Environment Configuration
# ==============================================================================

# Node Environment & Port (Hostinger VPS defaults to port 3000)
NODE_ENV=production
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls (Anti-scam detector & FB Post Formatter).
# Genera la chiave gratuita su: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted on your domain or VPS IP.
# Example: https://affittimilano.it
APP_URL="http://localhost:3000"

# Optional Client Firebase configuration overrides (already pre-bundled via firebase-applet-config.json)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_DATABASE_ID=""

